{
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "notebook.formatOnSave.enabled": false,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "r.bracketedPaste": true,
  "r.plot.useHttpgd": false,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "files.eol": "\n"
}
