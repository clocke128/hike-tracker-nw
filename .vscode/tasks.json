{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check my setup",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/check_setup.py",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Install packages from requirements.txt",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pip install -r requirements.txt",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest -q",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tidy code (format + lint)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/ruff format . && ${workspaceFolder}/.venv/bin/ruff check --fix .",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
